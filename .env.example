# Required for the contact form to actually send email.
# Sign up at https://resend.com, create an API key, and paste it here.
RESEND_API_KEY=

# Optional — where contact form submissions are sent. Defaults to the
# email in src/content/site.ts if unset.
CONTACT_TO_EMAIL=embudon@gmail.com

# Optional — the "from" address used by Resend. The default
# onboarding@resend.dev works immediately with no setup. Once you verify
# your own domain with Resend, switch this to an address on that domain
# (e.g. contact@yourdomain.com) for better deliverability.
RESEND_FROM_EMAIL=onboarding@resend.dev

# The canonical URL of the deployed site, used for metadata/OG tags and
# the sitemap. Update this once you know your real Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=https://noriel-embudo.vercel.app

# Optional — your real Calendly (or other scheduling) link, used by the
# "Book a call" buttons. Falls back to a placeholder in src/content/site.ts
# if unset.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/embudon/intro-call
